{
 "capabilities": [
  "fs.read",
  "fs.write",
  "exec"
 ],
 "description": "Read, write, edit, verify, map, and sandbox-run Python code \u2014 jailed to the code workspace",
 "name": "code",
 "tools": [
  {
   "capabilities": [
    "fs.read"
   ],
   "description": "Read a file from the code jail, returned with line numbers",
   "name": "code_read",
   "output_cap_chars": 10240,
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string"
     }
    },
    "required": [
     "path"
    ],
    "type": "object"
   },
   "returns": {
    "properties": {
     "content": {
      "type": "string"
     },
     "lines": {
      "type": "integer"
     },
     "path": {
      "type": "string"
     }
    },
    "required": [
     "content",
     "lines",
     "path"
    ],
    "type": "object"
   },
   "tier": 1,
   "timeout_s": 5
  },
  {
   "capabilities": [
    "fs.write"
   ],
   "description": "Write a whole file in the code jail (backs up existing file to <path>.bak, atomic write; a syntax-breaking .py write auto-reverts and reports)",
   "effects": [
    {
     "kind": "file",
     "target": "code/{args.path}"
    }
   ],
   "name": "code_write",
   "output_cap_chars": 10240,
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "content": {
      "type": "string"
     },
     "path": {
      "type": "string"
     }
    },
    "required": [
     "content",
     "path"
    ],
    "type": "object"
   },
   "postconditions": [
    {
     "check": "file_exists",
     "target": "code/{args.path}"
    }
   ],
   "returns": {
    "properties": {
     "backed_up": {
      "type": "boolean"
     },
     "path": {
      "type": "string"
     },
     "reverted": {
      "type": "boolean"
     },
     "syntax_error": {
      "type": "string"
     },
     "written": {
      "type": "boolean"
     }
    },
    "required": [
     "backed_up",
     "path",
     "written"
    ],
    "type": "object"
   },
   "tier": 2,
   "timeout_s": 5
  },
  {
   "capabilities": [
    "fs.write"
   ],
   "description": "Surgical edit: replace old_text with new_text via a 4-rung match ladder (exact/whitespace/unicode/structural), uniqueness enforced per rung, freshness gate (file must be read first and unchanged since); backs up to <path>.bak",
   "effects": [
    {
     "kind": "file",
     "target": "code/{args.path}"
    }
   ],
   "name": "code_edit",
   "output_cap_chars": 10240,
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "new_text": {
      "type": "string"
     },
     "old_text": {
      "type": "string"
     },
     "path": {
      "type": "string"
     }
    },
    "required": [
     "new_text",
     "old_text",
     "path"
    ],
    "type": "object"
   },
   "postconditions": [
    {
     "check": "file_exists",
     "target": "code/{args.path}"
    }
   ],
   "returns": {
    "properties": {
     "edited": {
      "type": "boolean"
     },
     "path": {
      "type": "string"
     },
     "reverted": {
      "type": "boolean"
     },
     "rung": {
      "type": "string"
     },
     "syntax_error": {
      "type": "string"
     }
    },
    "required": [
     "edited",
     "path",
     "rung",
     "reverted"
    ],
    "type": "object"
   },
   "tier": 2,
   "timeout_s": 5
  },
  {
   "capabilities": [
    "exec",
    "fs.read"
   ],
   "description": "Differential test verification: first call snapshots the baseline test state; after edits, call again for a FULL/PARTIAL/NO verdict computed from test outcomes only (optional repro script must flip fail->pass)",
   "name": "code_verify",
   "output_cap_chars": 10240,
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "command": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "repro": {
      "type": "string"
     },
     "reset": {
      "type": "boolean"
     }
    },
    "required": [
     "command"
    ],
    "type": "object"
   },
   "returns": {
    "properties": {
     "baseline": {
      "type": "object"
     },
     "current": {
      "type": "object"
     },
     "fixed": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "parseable": {
      "type": "boolean"
     },
     "phase": {
      "type": "string"
     },
     "regressions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "remaining_failures": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "repro": {
      "type": "string"
     },
     "verdict": {
      "type": "string"
     }
    },
    "required": [
     "phase",
     "verdict",
     "parseable",
     "current",
     "fixed",
     "regressions",
     "remaining_failures",
     "repro"
    ],
    "type": "object"
   },
   "tier": 1,
   "timeout_s": 180
  },
  {
   "capabilities": [
    "fs.read"
   ],
   "description": "Ranked map of the jail's Python definitions (AST def/ref graph + PageRank, sqlite-cached): which functions/classes exist, where, and what matters",
   "name": "code_map",
   "output_cap_chars": 20480,
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "focus": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [],
    "type": "object"
   },
   "returns": {
    "properties": {
     "files": {
      "type": "integer"
     },
     "map": {
      "type": "string"
     },
     "nodes": {
      "type": "integer"
     },
     "symbols": {
      "type": "array"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "map",
     "symbols",
     "files",
     "nodes",
     "truncated"
    ],
    "type": "object"
   },
   "tier": 1,
   "timeout_s": 30
  },
  {
   "capabilities": [
    "exec",
    "fs.read"
   ],
   "description": "Run Python code in a sandbox: separate process, 10s timeout, no shell, network blocked, jail cwd, 10KB output cap",
   "name": "code_run",
   "output_cap_chars": 10240,
   "parameters": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "path": {
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "returns": {
    "properties": {
     "exit_code": {
      "type": "integer"
     },
     "stderr": {
      "type": "string"
     },
     "stdout": {
      "type": "string"
     },
     "timed_out": {
      "type": "boolean"
     }
    },
    "required": [
     "exit_code",
     "stderr",
     "stdout",
     "timed_out"
    ],
    "type": "object"
   },
   "tier": 3,
   "timeout_s": 15
  }
 ],
 "version": "1.1.0"
}
